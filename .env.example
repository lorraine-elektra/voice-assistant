# Copy this file to .env and fill in your own values. Never commit .env.

# Run with no API keys. Set to false only when your keys are in place.
MOCK_MODE=true

# Gemini (the replies and language detection). Free key: https://aistudio.google.com/
# Both are needed. Without them the replies stay on the mock.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Abena AI (Twi and Pidgin voices and listening). Optional: its playground API works
# without a key. Key from https://abena.mobobi.com/playground/sdk/dashboard/
ABENA_API_KEY=
