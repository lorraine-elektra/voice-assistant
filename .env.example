# Copy this file to .env and fill in your own values. Never commit .env.

# Run with no API keys. Set to false only when your keys are in place.
MOCK_MODE=true

# Gemini (the replies and language detection). Free key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (speech to text, Whisper). Free key: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3

# Abena AI (Twi and Pidgin voices). Key from https://abena.mobobi.com/playground/sdk/dashboard/
# Without a key the browser's voice speaks Twi and Pidgin.
ABENA_API_KEY=

# Deepgram (speech to text). Without a key the browser's speech recognition is used.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ElevenLabs (text to speech). Without a key and a voice id the browser's voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. More voices for the voice picker on the page, as Name:id pairs with commas
# between them, for example Ama:abc123,Tunde:def456. Take the ids from your ElevenLabs account.
ELEVENLABS_VOICES=
# Optional. Leave empty to use ElevenLabs' default model.
ELEVENLABS_MODEL=
