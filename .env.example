# Copy this file to .env and fill in your own values. Never commit .env.

# Run with no API keys. Set to false only when your keys are in place.
MOCK_MODE=true

# Gemini (the replies and language detection). Free key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq (speech to text, Whisper). Free key: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3

# Abena AI (Twi and Pidgin voices). Key from https://abena.mobobi.com/playground/sdk/dashboard/
# Without a key the browser's voice speaks Twi and Pidgin.
ABENA_API_KEY=
