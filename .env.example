# Copy this file to .env and fill in your own values. Never commit .env.

# Run with no API keys. Set to false only when your keys are in place.
MOCK_MODE=true

# Phase 1
ANTHROPIC_API_KEY=
# A fast model suits voice. Change it if you want better answers over speed.
ANTHROPIC_MODEL=claude-haiku-5-5

# Phase 2
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
