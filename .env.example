# Copy this file to .env and fill in your own values. Never commit .env.

# Run with no API keys. Set to false only when your keys are in place.
MOCK_MODE=true

# Claude (the replies)
ANTHROPIC_API_KEY=
# A fast model suits voice. Change it if you want better answers over speed.
ANTHROPIC_MODEL=claude-haiku-5-5
# How hard the model thinks: low, medium or high. Low is fastest.
ANTHROPIC_EFFORT=low
# Most web searches allowed in one reply. Each search costs extra and adds waiting time.
WEB_SEARCH_MAX_USES=2

# Deepgram (speech to text). Without a key the browser's speech recognition is used.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ElevenLabs (text to speech). Without a key and a voice id the browser's voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. More voices for the voice picker on the page, as Name:id pairs with commas
# between them, for example Ama:abc123,Tunde:def456. Take the ids from your ElevenLabs account.
ELEVENLABS_VOICES=
# Optional. Leave empty to use ElevenLabs' default model.
ELEVENLABS_MODEL=
